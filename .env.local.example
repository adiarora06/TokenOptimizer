# Copy this file to .env.local and add rotated keys.
# Do not put real keys in the frontend HTML.

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: enables estimated dollar cost in the usage strip.
GROQ_INPUT_COST_PER_MILLION=
GROQ_OUTPUT_COST_PER_MILLION=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=

# Server-funded production access is fail-closed. Set a strong bearer token for
# private/API-client access, or explicitly opt into a public funded demo. BYOK
# and offline requests do not require this token and do not consume its budget.
TOKEN_OPTIMIZER_ACCESS_TOKEN=
TOKEN_OPTIMIZER_ALLOW_PUBLIC_FUNDED=0

# Request and provider-spend safety limits. They are process-local with the
# default memory backend and deployment-wide with the optional Upstash backend.
TOKEN_OPTIMIZER_MAX_INPUT_CHARS=80000
TOKEN_OPTIMIZER_MAX_OUTPUT_TOKENS=4096
TOKEN_OPTIMIZER_MAX_RESPONSE_BYTES=1048576
TOKEN_OPTIMIZER_RATE_MAX=20
TOKEN_OPTIMIZER_RATE_WINDOW_MS=60000
TOKEN_OPTIMIZER_PREP_RATE_MAX=60
TOKEN_OPTIMIZER_PREP_RATE_WINDOW_MS=60000
TOKEN_OPTIMIZER_RATE_BUCKET_CAP=1000
TOKEN_OPTIMIZER_MAX_CONCURRENCY=4
TOKEN_OPTIMIZER_DAILY_CALL_LIMIT=500
TOKEN_OPTIMIZER_DAILY_TOKEN_LIMIT=2000000
TOKEN_OPTIMIZER_IDEMPOTENCY_MAX_ENTRIES=500
TOKEN_OPTIMIZER_IDEMPOTENCY_TTL_MS=360000

# Optional deployment-wide coordination. `memory` is dependency-free and is
# best for local development. Set `upstash` in production only after all three
# server-only values below are configured. Missing/invalid shared configuration
# then fails closed instead of silently weakening the guard.
TOKEN_OPTIMIZER_SHARED_GUARD_BACKEND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Separate 32+ byte secret used to HMAC identities and AES-GCM encrypt the
# short-lived idempotency replay value stored in Redis.
TOKEN_OPTIMIZER_SHARED_GUARD_SECRET=
# Optional override. Leave blank to isolate by Vercel project + environment.
# If set, use different stable values for production, preview, and development.
TOKEN_OPTIMIZER_SHARED_GUARD_NAMESPACE=
# Advanced millisecond tuning; most deployments should keep these defaults.
TOKEN_OPTIMIZER_SHARED_GUARD_TIMEOUT_MS=2500
TOKEN_OPTIMIZER_SHARED_CONCURRENCY_LEASE_MS=220000
TOKEN_OPTIMIZER_SHARED_PENDING_TTL_MS=220000
TOKEN_OPTIMIZER_SHARED_WAIT_MS=5000
TOKEN_OPTIMIZER_SHARED_POLL_MS=1000
TOKEN_OPTIMIZER_SHARED_REPLAY_MAX_BYTES=1500000

# Metadata-only telemetry. Structured JSON logging defaults on in production
# when this is blank; set 0 to disable or 1 to enable in local development.
TOKEN_OPTIMIZER_TELEMETRY_LOG=
TOKEN_OPTIMIZER_TELEMETRY_MAX_EVENTS=200

# Alert policy used by the process overview and deployment-log analyzer.
TOKEN_OPTIMIZER_ALERT_MIN_PROVIDER_ATTEMPTS=10
TOKEN_OPTIMIZER_ALERT_MIN_WORKFLOW_RUNS=10
TOKEN_OPTIMIZER_ALERT_PROVIDER_FAILURE_WARNING_PERCENT=10
TOKEN_OPTIMIZER_ALERT_PROVIDER_FAILURE_CRITICAL_PERCENT=25
TOKEN_OPTIMIZER_ALERT_WORKFLOW_FAILURE_WARNING_PERCENT=10
TOKEN_OPTIMIZER_ALERT_WORKFLOW_FAILURE_CRITICAL_PERCENT=25
TOKEN_OPTIMIZER_ALERT_FALLBACK_RETRY_WARNING_PERCENT=10
TOKEN_OPTIMIZER_ALERT_FALLBACK_RETRY_CRITICAL_PERCENT=25
TOKEN_OPTIMIZER_ALERT_P95_LATENCY_WARNING_MS=10000
TOKEN_OPTIMIZER_ALERT_P95_LATENCY_CRITICAL_MS=30000
# Optional window-level spend limits. Leave blank to disable cost alerts.
TOKEN_OPTIMIZER_ALERT_COST_WARNING_USD=
TOKEN_OPTIMIZER_ALERT_COST_CRITICAL_USD=

# Standalone Node deployments ignore x-forwarded-for unless this is enabled
# behind a proxy that overwrites the header. Vercel enables trusted handling automatically.
TOKEN_OPTIMIZER_TRUST_PROXY=0

# Leave disabled in production. Custom endpoint DNS results are validated and
# pinned; local development already permits localhost endpoints.
TOKEN_OPTIMIZER_ALLOW_PRIVATE_ENDPOINTS=0
